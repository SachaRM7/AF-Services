# --- Frontend (exposées au navigateur : uniquement des valeurs publiques) ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# URL publique du site (SEO, liens de réinitialisation de mot de passe)
VITE_SITE_URL=https://af-nettoyage.netlify.app

# --- Fonctions Netlify (secrètes : à définir dans Netlify > Site settings > Environment variables) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Sel utilisé pour pseudonymiser les adresses IP (anti-abus, RGPD)
IP_HASH_SALT=change-me-long-random-string
# Optionnel : Cloudflare Turnstile (anti-spam). Si vide, seuls pot de miel + délai + quota sont actifs.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
